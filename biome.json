{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!src/toolfactory",
      "!dev.toolfactory",
      "!schemas",
      "!.claude-plugin",
      "!.codex-plugin",
      "!.cursor-plugin",
      "!mcp.json",
      "!server.json",
      "!COVERAGE.md",
      "!hosts",
      "!web",
      "!renovate.json",
      "!.agents/skills",
      "!.agents/mcp/servers.json"
    ]
  }
}
