{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub Action pins in the workflows generator (the generated workflows are SHA-locked projections)",
      "managerFilePatterns": [
        "/^src/surfaces/workflows\\.ts$/"
      ],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9-]*/[A-Za-z0-9._-]+)@(?<currentValue>v\\d+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "DSH_PIN, the @deepseek-ai/dsh release the dsh surface's validator boots",
      "managerFilePatterns": [
        "/^src/surfaces/dsh\\.ts$/"
      ],
      "matchStrings": [
        "DSH_PIN = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "@deepseek-ai/dsh",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "MCPB_PIN, the @anthropic-ai/mcpb release the mcpb surface validates and packs with",
      "managerFilePatterns": [
        "/^src/surfaces/mcpb\\.ts$/"
      ],
      "matchStrings": [
        "MCPB_PIN = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "@anthropic-ai/mcpb",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "WXT_PIN, the wxt release the browser-extension surface scaffolds and validates with",
      "managerFilePatterns": [
        "/^src/surfaces/browser-extension\\.ts$/"
      ],
      "matchStrings": [
        "WXT_PIN = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "wxt",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "HERMES_PIN.commit, the hermes-agent commit the hermes surface installs in CI",
      "managerFilePatterns": [
        "/^src/surfaces/hermes-native\\.ts$/"
      ],
      "matchStrings": [
        "commit: \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "https://github.com/NousResearch/hermes-agent",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "GEMINI_PIN, the @google/gemini-cli release the gemini surface's validator runs",
      "managerFilePatterns": [
        "/^src/surfaces/gemini\\.ts$/"
      ],
      "matchStrings": [
        "GEMINI_PIN = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "@google/gemini-cli",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "CODEX_PIN, the @openai/codex release the codex surface's validator runs",
      "managerFilePatterns": [
        "/^src/surfaces/codex\\.ts$/"
      ],
      "matchStrings": [
        "CODEX_PIN = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "@openai/codex",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "ignorePaths": [
    ".github/workflows/**",
    "hosts/*/package.json",
    "web/package.json"
  ],
  "packageRules": [
    {
      "description": "DSH publishes no stable release: its alpha line is the only thing to track, and npm's latest tag lags it.",
      "matchPackageNames": [
        "@deepseek-ai/dsh"
      ],
      "ignoreUnstable": false,
      "respectLatest": false
    }
  ]
}
