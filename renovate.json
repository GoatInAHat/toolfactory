{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub Action pins in the workflows generator (the generated workflows are SHA-locked projections)",
      "managerFilePatterns": [
        "/^src/surfaces/workflows\\.ts$/"
      ],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9-]*/[A-Za-z0-9._-]+)@(?<currentValue>v\\d+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "DSH_PIN, the @deepseek-ai/dsh release the dsh surface's validator boots",
      "managerFilePatterns": [
        "/^src/surfaces/dsh\\.ts$/"
      ],
      "matchStrings": [
        "DSH_PIN = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "@deepseek-ai/dsh",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "HERMES_PIN.commit, the hermes-agent commit the hermes surface installs in CI",
      "managerFilePatterns": [
        "/^src/surfaces/hermes-native\\.ts$/"
      ],
      "matchStrings": [
        "commit: \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "https://github.com/NousResearch/hermes-agent",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "ignorePaths": [
    ".github/workflows/**",
    "hosts/*/package.json",
    "web/package.json"
  ],
  "packageRules": [
    {
      "description": "DSH publishes no stable release: its alpha line is the only thing to track, and npm's latest tag lags it.",
      "matchPackageNames": [
        "@deepseek-ai/dsh"
      ],
      "ignoreUnstable": false,
      "respectLatest": false
    }
  ]
}
